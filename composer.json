{
    "name": "yiisoft/yii-runner-roadrunner",
    "type": "library",
    "description": "Web application runner for RoadRunner",
    "keywords": [
        "yii3",
        "roadrunner"
    ],
    "homepage": "https://www.yiiframework.com/",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii-runner-roadrunner/issues?state=open",
        "source": "https://github.com/yiisoft/yii-runner-roadrunner",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "ircs://irc.libera.chat:6697/yii",
        "chat": "https://t.me/yii3en"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/yiisoft"
        },
        {
            "type": "github",
            "url": "https://github.com/sponsors/yiisoft"
        }
    ],
    "require": {
        "php": "8.2 - 8.6",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "roadrunner/cli": "^3.0.1",
        "roadrunner/grpc": "^3.8.1",
        "roadrunner/http": "^4.2.1",
        "roadrunner/worker": "^3.8.2",
        "yiisoft/definitions": "^1.0 || ^2.0 || ^3.0",
        "yiisoft/di": "^1.0",
        "yiisoft/error-handler": "^4.0",
        "yiisoft/http": "^1.2",
        "psr/log": "^2.0|^3.0",
        "yiisoft/log": "^2.0",
        "yiisoft/log-target-file": "^3.0",
        "yiisoft/yii-http": "^1.0",
        "yiisoft/yii-runner": "^2.0"
    },
    "require-dev": {
        "ext-mbstring": "*",
        "friendsofphp/php-cs-fixer": "^3.93",
        "google/protobuf": "^4.33 || ^5.0",
        "grpc/grpc": "^1.50.0",
        "httpsoft/http-message": "^1.0",
        "infection/infection": "^0.29.8 || ^0.35.8",
        "phpunit/phpunit": "^10.3",
        "psr/event-dispatcher": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "rector/rector": "^2.5.6",
        "roadrunner/goridge": "^4.6",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spatie/phpunit-watcher": "^1.23",
        "temporal/sdk": "^2.20",
        "vimeo/psalm": "^5.22 || ^6.1",
        "yiisoft/code-style": "^1.0",
        "yiisoft/config": "^1.1",
        "yiisoft/middleware-dispatcher": "^5.0",
        "yiisoft/test-support": "^3.0",
        "yiisoft/yii-event": "^2.2"
    },
    "suggest": {
        "ext-protobuf": "For better performance",
        "grpc/grpc": "Needed for gRPC support",
        "ext-grpc": "Needed for gRPC support",
        "temporal/sdk": "Add Temporal support"
    },
    "autoload": {
        "psr-4": {
            "Yiisoft\\Yii\\Runner\\RoadRunner\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yiisoft\\Yii\\Runner\\RoadRunner\\Tests\\": "tests",
            "GPBMetadata\\": [
                "tests/Support/Grpc/GPBMetadata"
            ],
            "Service\\": "tests/Support/Grpc/Service"
        }
    },
    "extra": {
        "config-plugin-options": {
            "source-directory": "config",
            "build-merge-plan": false
        },
        "config-plugin": {
            "di": "di-*.php",
            "params": "params.php"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "composer/package-versions-deprecated": true,
            "yiisoft/config": true
        }
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "dependency-analyser": "composer-dependency-analyser",
        "rector": "rector",
        "test": "phpunit --testdox",
        "test-watch": "phpunit-watcher watch"
    }
}
